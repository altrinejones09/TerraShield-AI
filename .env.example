# ==============================================================================
# TerraShield AI — Environment Variable Reference Template
# DO NOT COMMIT REAL CREDENTIALS, AWS ACCESS KEYS, OR PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# Frontend Environment Variables (Vite)
# Leave blank to run in deterministic in-browser demonstration mode
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=us-east-1

# Optional Local Backend Dev Server (Port 4000)
# Example: VITE_API_BASE_URL=http://localhost:4000/api
PORT=4000

# AWS Cloud Backend Variables (Configured by AWS SAM CloudFormation stack)
# DYNAMODB_TABLE_DEVICES=TerraShield-Devices
# DYNAMODB_TABLE_READINGS=TerraShield-Readings
# DYNAMODB_TABLE_ALERTS=TerraShield-Alerts
# AWS_IOT_ENDPOINT=your-ats-endpoint.iot.us-east-1.amazonaws.com
